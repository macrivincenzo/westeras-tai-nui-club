---
interface Props {
	videoId: string;
	title: string;
	description?: string;
}

const { videoId, title, description } = Astro.props;
const thumbUrl = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
---

<article class="video-card" data-video-id={videoId} tabindex="0" role="button">
	<div class="video-card-thumb-wrap">
		<img
			src={thumbUrl}
			alt={title}
			loading="lazy"
			width="480"
			height="360"
			class="video-card-thumb"
		/>
		<span class="video-card-play" aria-hidden="true">▶</span>
	</div>
	<div class="video-card-body">
		<h3 class="video-card-title">{title}</h3>
		{description && <p class="video-card-desc">{description}</p>}
	</div>
</article>

<style>
	.video-card {
		background: #fff;
		border-radius: 10px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
		overflow: hidden;
		cursor: pointer;
		transition: box-shadow 0.3s ease, transform 0.2s ease;
	}
	.video-card:hover {
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
		transform: translateY(-2px);
	}
	.video-card-thumb-wrap {
		position: relative;
		aspect-ratio: 16 / 9;
		background: #1a1a1a;
	}
	.video-card-thumb {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.video-card-play {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.3);
		color: white;
		font-size: 3rem;
		transition: background 0.3s ease;
	}
	.video-card:hover .video-card-play {
		background: rgba(0, 0, 0, 0.5);
	}
	.video-card.is-playing .video-card-thumb-wrap {
		position: relative;
	}
	.video-card.is-playing .video-card-thumb,
	.video-card.is-playing .video-card-play {
		display: none;
	}
	.video-card-body {
		padding: 1rem 1.25rem;
	}
	.video-card-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: #1a1a1a;
		margin: 0 0 0.5rem 0;
		line-height: 1.3;
	}
	.video-card-desc {
		font-size: 0.95rem;
		color: #555;
		margin: 0;
		line-height: 1.5;
	}
	.video-card iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
