			m.addEventListener('click', () => { m.classList.toggle('active'); n.classList.toggle('active'); });
			document.querySelectorAll('.dropdown-toggle').forEach(t => {
				t.addEventListener('click', (e) => {
					if (window.innerWidth <= 768) { e.preventDefault(); t.parentElement.classList.toggle('active'); }
				});
			});
			document.addEventListener('click', (e) => {
				if (!e.target.closest('.nav-container')) { m.classList.remove('active'); n.classList.remove('active'); }
			});
			document.querySelectorAll('.nav-links a:not(.dropdown-toggle)').forEach(l => {
				l.addEventListener('click', () => { m.classList.remove('active'); n.classList.remove('active'); });
			});
		</script>

