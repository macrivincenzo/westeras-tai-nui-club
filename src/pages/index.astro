				mobileMenuToggle.classList.toggle('active');
				navMenu.classList.toggle('active');
			});
			
			// Mobile dropdown toggle
			const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
			dropdownToggles.forEach(toggle => {
				toggle.addEventListener('click', (e) => {
					// Only prevent default on mobile
					if (window.innerWidth <= 768) {
						e.preventDefault();
						const dropdown = toggle.parentElement;
						dropdown.classList.toggle('active');
					}
				});
			});
			
			// Close mobile menu when clicking outside (passive för bättre prestanda)
			document.addEventListener('click', (e) => {
				if (!e.target.closest('.nav-container')) {
					mobileMenuToggle.classList.remove('active');
					navMenu.classList.remove('active');
				}
			}, { passive: true });
			
			// Close mobile menu when clicking a link (except dropdown toggle)
			const navLinks = document.querySelectorAll('.nav-links a:not(.dropdown-toggle)');
			navLinks.forEach(link => {
				link.addEventListener('click', () => {
					mobileMenuToggle.classList.remove('active');
					navMenu.classList.remove('active');
				});
			});
			
			// Hero carousel - optimized
			const heroSlides = document.querySelectorAll('.hero-slide');
			const isDesktop = window.innerWidth >= 769;
			let currentSlide = 0;
			let carouselInterval = null;
			let lastTime = 0;
			
			function slideAllowed(slide) {
				const isMobileSlide = slide.classList.contains('hero-slide-mobile');
				const isDesktopSlide = slide.classList.contains('hero-slide-desktop');
				if (isDesktop && isMobileSlide) {
					return false;
				}
				if (!isDesktop && isDesktopSlide) {
					return false;
				}
				return true;
			}
			
			function getImageUrl(slide) {
				const isMobile = window.innerWidth <= 768;
				const mobileUrl = slide.dataset.bgMobile;
				const desktopUrl = slide.dataset.bg;
				const fallbackUrl = slide.dataset.fallback;
				
				// Välj mobil eller desktop bild
				let url = isMobile && mobileUrl ? mobileUrl : (desktopUrl || fallbackUrl);
				
				// Test WebP support
				const webpSupported = document.createElement('canvas').toDataURL('image/webp').indexOf('data:image/webp') === 0;
				
				if (!webpSupported && url && url.endsWith('.webp') && fallbackUrl) {
					url = fallbackUrl;
				}
				
				return url;
			}
			
			function preloadNextSlide(nextIndex) {
				// På mobil, preloada bara när användaren är nära att se nästa slide
				if (!isDesktop && isScrolling) {
					return;
				}
				
				if (heroSlides[nextIndex] && slideAllowed(heroSlides[nextIndex])) {
					const slide = heroSlides[nextIndex];
					const url = getImageUrl(slide);
					
					if (url) {
						// På mobil, fördröj preloading mer för bättre initial load
						if (!isDesktop) {
							// Använd requestIdleCallback med längre timeout på mobil
							if ('requestIdleCallback' in window) {
								requestIdleCallback(() => {
									const img = new Image();
									img.loading = 'lazy';
									img.src = url;
								}, { timeout: 3000 });
							} else {
								// Fallback: fördröj med setTimeout på mobil
								setTimeout(() => {
									const img = new Image();
									img.loading = 'lazy';
									img.src = url;
								}, 1000);
							}
						} else {
							// Desktop: preload direkt
							const img = new Image();
							img.src = url;
						}
					}
				}
			}
			
			function showSlide(index) {
				heroSlides.forEach((slide, i) => {
					if (i === index && slideAllowed(slide)) {
						const url = getImageUrl(slide);
						if (url) {
							slide.style.backgroundImage = `url('${url}')`;
						}
						slide.classList.add('active');
						// Preload next slide
						const nextIndex = (index + 1) % heroSlides.length;
						preloadNextSlide(nextIndex);
					} else {
						slide.classList.remove('active');
					}
				});
				currentSlide = index;
			}
			
			// Initial load med rätt bild
			function initializeSlides() {
				heroSlides.forEach((slide) => {
					if (slide.classList.contains('active')) {
						const url = getImageUrl(slide);
						if (url) {
							slide.style.backgroundImage = `url('${url}')`;
						}
					}
				});
			}
			
			function nextSlide() {
				let nextIndex = currentSlide;
				do {
					nextIndex = (nextIndex + 1) % heroSlides.length;
					if (slideAllowed(heroSlides[nextIndex])) {
						break;
					}
				} while (nextIndex !== currentSlide);
				showSlide(nextIndex);
			}
			
			// Initialize slides with correct images
			initializeSlides();
			
			const initialIndex = Array.from(heroSlides).findIndex(slide => slideAllowed(slide));
			if (initialIndex >= 0) {
				showSlide(initialIndex);
			} else {
				showSlide(0);
			}
			
			// Handle resize for responsive images (passive och debounced för bättre prestanda)
			let resizeTimeout;
			window.addEventListener('resize', () => {
				clearTimeout(resizeTimeout);
				resizeTimeout = setTimeout(() => {
					showSlide(currentSlide); // Reload current slide with correct image
				}, 200);
			}, { passive: true });
			
			// Use requestAnimationFrame for better performance (pausa på mobil för bättre prestanda)
			let animationId;
			let isCarouselVisible = true;
			let isScrolling = false;
			let scrollTimeout;
			
			// Pausa carousel när användaren scrollar (mobil-optimering)
			window.addEventListener('scroll', () => {
				isScrolling = true;
				clearTimeout(scrollTimeout);
				scrollTimeout = setTimeout(() => {
					isScrolling = false;
				}, 150);
			}, { passive: true });
			
			// Intersection Observer för att pausa när hero-sektionen inte är synlig
			if ('IntersectionObserver' in window) {
				const heroSection = document.querySelector('.hero');
				if (heroSection) {
					const observer = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							isCarouselVisible = entry.isIntersecting;
						});
					}, { threshold: 0.1 });
					observer.observe(heroSection);
				}
			}
			
			function animateCarousel(currentTime) {
				if (!lastTime) lastTime = currentTime;
				const timeDiff = currentTime - lastTime;
				
				// Pausa carousel när sidan inte är synlig, användaren scrollar, eller hero-sektionen inte är synlig
				if (document.hidden || (isScrolling && !isDesktop) || !isCarouselVisible) {
					animationId = requestAnimationFrame(animateCarousel);
					return;
				}
				
				// Snabbare på mobil (7 sekunder istället för 5) för bättre prestanda
				const interval = isDesktop ? 5000 : 7000;
				
				if (timeDiff >= interval) {
					nextSlide();
					lastTime = currentTime;
				}
				animationId = requestAnimationFrame(animateCarousel);
			}
			animationId = requestAnimationFrame(animateCarousel);
			
			// Load Google Maps iframe - enkel och pålitlig lösning
			const mapIframe = document.getElementById('google-map-iframe');
			
			if (mapIframe && mapIframe.dataset.src) {
				const loadMap = () => {
					if (mapIframe.dataset.src) {
						mapIframe.src = mapIframe.dataset.src;
						mapIframe.removeAttribute('data-src');
					}
				};
				
				// Använd matchMedia för att detektera mobil (mer pålitligt)
				const mobileMediaQuery = window.matchMedia('(max-width: 768px)');
				
				// Funktion för att kontrollera och ladda
				const checkAndLoad = () => {
					if (mobileMediaQuery.matches) {
						// På mobil: ladda direkt
						loadMap();
					} else {
						// Desktop: lazy load när synlig
						if ('IntersectionObserver' in window) {
							const observer = new IntersectionObserver((entries) => {
								entries.forEach(entry => {
									if (entry.isIntersecting) {
										loadMap();
										observer.disconnect();
									}
								});
							}, { rootMargin: '50px' });
							observer.observe(mapIframe);
						} else {
							loadMap();
						}
					}
				};
				
				// Kör direkt när scriptet körs
				checkAndLoad();
				
				// Fallback: ladda vid användarinteraktion
				['click', 'touchstart', 'scroll'].forEach(event => {
					document.addEventListener(event, loadMap, { once: true, passive: true });
				});
			}
		</script>
		
