		<script defer>
			// Mobile menu toggle
			const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
			const navMenu = document.querySelector('.nav-menu');
			
			mobileMenuToggle.addEventListener('click', () => {
				mobileMenuToggle.classList.toggle('active');
				navMenu.classList.toggle('active');
			});
			
			// Mobile dropdown toggle
			const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
			dropdownToggles.forEach(toggle => {
				toggle.addEventListener('click', (e) => {
					// Only prevent default on mobile
					if (window.innerWidth <= 768) {
						e.preventDefault();
						const dropdown = toggle.parentElement;
						dropdown.classList.toggle('active');
					}
				});
			});
			
			// Close mobile menu when clicking outside
			document.addEventListener('click', (e) => {
				if (!e.target.closest('.nav-container')) {
					mobileMenuToggle.classList.remove('active');
					navMenu.classList.remove('active');
				}
			});
			
			// Close mobile menu when clicking a link (except dropdown toggle)
			const navLinks = document.querySelectorAll('.nav-links a:not(.dropdown-toggle)');
			navLinks.forEach(link => {
				link.addEventListener('click', () => {
					mobileMenuToggle.classList.remove('active');
					navMenu.classList.remove('active');
				});
			});
			
			// Hero carousel
			const heroSlides = document.querySelectorAll('.hero-slide');
			const isDesktop = window.innerWidth >= 769;
			let currentSlide = 0;
			
			function slideAllowed(slide) {
				const isMobileSlide = slide.classList.contains('hero-slide-mobile');
				const isDesktopSlide = slide.classList.contains('hero-slide-desktop');
				if (isDesktop && isMobileSlide) {
					return false;
				}
				if (!isDesktop && isDesktopSlide) {
					return false;
				}
				return true;
			}
			
			function showSlide(index) {
				heroSlides.forEach(slide => slide.classList.remove('active'));
				heroSlides[index].classList.add('active');
				currentSlide = index;
			}
			
			function nextSlide() {
				let nextIndex = currentSlide;
				do {
					nextIndex = (nextIndex + 1) % heroSlides.length;
					if (slideAllowed(heroSlides[nextIndex])) {
						break;
					}
				} while (nextIndex !== currentSlide);
				showSlide(nextIndex);
			}
			
			const initialIndex = Array.from(heroSlides).findIndex(slide => slideAllowed(slide));
			if (initialIndex >= 0) {
				showSlide(initialIndex);
			} else {
				showSlide(0);
			}
			
			// Change slide every 5 seconds
			setInterval(nextSlide, 5000);
		</script>
		
