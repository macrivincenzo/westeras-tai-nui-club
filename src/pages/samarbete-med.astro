				margin-bottom: 2rem;
				opacity: 0.9;
			}
			
			.cta-buttons {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			
			.btn {
				padding: 15px 30px;
				border: none;
				border-radius: 5px;
				font-size: 1.1rem;
				font-weight: 600;
				text-decoration: none;
				display: inline-block;
				transition: all 0.3s ease;
				cursor: pointer;
			}
			
			.btn-primary {
				background: #dc2626;
				color: white;
			}
			
			.btn-primary:hover {
				background: #b91c1c;
				transform: translateY(-2px);
			}
			
			.btn-secondary {
				background: transparent;
				color: white;
				border: 2px solid white;
			}
			
			.btn-secondary:hover {
				background: white;
				color: black;
			}
			
			/* Footer */
			.footer {
				background: #000;
				color: white;
				padding: 3rem 0;
				text-align: center;
			}
			
			.footer-content {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
				margin-bottom: 2rem;
			}
			
			.footer h4 {
				margin-bottom: 1rem;
				color: #dc2626;
			}
			
			.footer a {
				color: #ccc;
				text-decoration: none;
			}
			
			.footer a:hover {
				color: white;
			}
			
					/* Mobile Menu Toggle Button */
			.mobile-menu-toggle {
				display: none;
				flex-direction: column;
				background: transparent;
				border: none;
				cursor: pointer;
				padding: 0;
				z-index: 1001;
			}
			
			.mobile-menu-toggle span {
				width: 25px;
				height: 3px;
				background: white;
				margin: 3px 0;
				transition: all 0.3s ease;
				border-radius: 3px;
			}
			
			.mobile-menu-toggle.active span:nth-child(1) {
				transform: rotate(45deg) translate(8px, 8px);
			}
			
			.mobile-menu-toggle.active span:nth-child(2) {
				opacity: 0;
			}
			
			.mobile-menu-toggle.active span:nth-child(3) {
				transform: rotate(-45deg) translate(7px, -7px);
			}
			
			/* Responsive Design */
			@media (max-width: 768px) {
				.mobile-menu-toggle {
					display: flex;
				}
				
				.nav-menu {
					position: fixed;
					top: 0;
					right: -100%;
					width: 80%;
					max-width: 400px;
					height: 100vh;
					background: #000;
					padding: 80px 20px 20px;
					transition: right 0.3s ease;
					overflow-y: auto;
					z-index: 1000;
				}
				
				.nav-menu.active {
					right: 0;
				}
				
				.nav-links {
					flex-direction: column;
					gap: 0;
				}
				
				.nav-links > li {
					border-bottom: 1px solid #333;
				}
				
				.nav-links > li > a {
					display: block;
					padding: 1rem 0;
				}
				
				/* Mobile Dropdown */
				.dropdown-menu {
					position: static;
					opacity: 1;
					visibility: visible;
					transform: none;
					background: #1a1a1a;
					max-height: 0;
					overflow: hidden;
					transition: max-height 0.3s ease;
					box-shadow: none;
					border-radius: 0;
					margin: 0;
					padding: 0;
				}
				
				.dropdown.active .dropdown-menu {
					max-height: 500px;
					padding: 0.5rem 0;
				}
				
				.dropdown-toggle {
					justify-content: space-between;
					width: 100%;
				}
				
				.dropdown .arrow {
					transition: transform 0.3s ease;
				}
				
				.dropdown.active .arrow {
					transform: rotate(180deg);
				}
				.nav-container {
					flex-direction: column;
					gap: 1rem;
				}
				
				.nav-links {
					gap: 1rem;
				}
				
				.hero h1 {
					font-size: 2.5rem;
				}
				
				.cta-buttons {
					flex-direction: column;
					align-items: center;
				}
				
				.btn {
					width: 100%;
					max-width: 300px;
				}
			}
		</style>
